#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT

git diff --cached --name-only --diff-filter=ACMT --no-renames -z -- input/ report/ > "$scratch/paths"
reports=()
while IFS= read -r -d '' path; do
    case "$path" in
        input/*/*)
            printf 'Commit blocked: personal input path %s\n' "$path" >&2
            exit 1
            ;;
        input/*.test.txt) ;;
        input/*)
            printf 'Commit blocked: personal input path %s\n' "$path" >&2
            exit 1
            ;;
        report/*.md) reports+=("$path") ;;
    esac
done < "$scratch/paths"

if (( ${#reports[@]} == 0 )); then
    exit 0
fi

shopt -s nullglob dotglob
: > "$scratch/patterns"
for input in input/*; do
    case "$input" in
        *.test.txt) continue ;;
    esac
    [[ -f "$input" ]] || continue
    # Normalize CRLF so the match also works for inputs saved by Windows editors.
    LC_ALL=C sed -e $'s/\r$//' -e '/^[[:space:]]*$/d' "$input" >> "$scratch/patterns"
    printf '\n' >> "$scratch/patterns"
done
LC_ALL=C sed '/^$/d' "$scratch/patterns" > "$scratch/nonblank"
[[ -s "$scratch/nonblank" ]] || exit 0
sed 's/^/"/; s/$/"/' "$scratch/nonblank" > "$scratch/quoted"

for path in "${reports[@]}"; do
    git show ":$path" | LC_ALL=C sed $'s/\r$//' > "$scratch/report"
    for pattern_file in nonblank quoted; do
        flags=(-Ff)
        [[ "$pattern_file" != nonblank ]] || flags=(-Fxf)
        if LC_ALL=C grep "${flags[@]}" "$scratch/$pattern_file" "$scratch/report" >/dev/null; then
            printf 'Commit blocked: staged report %s contains a line from a personal input.\n' "$path" >&2
            exit 1
        else
            result=$?
            if (( result != 1 )); then
                exit "$result"
            fi
        fi
    done
done
